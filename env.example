# Azure DevOps Configuration
# Your Azure DevOps organization name (e.g., "contoso")
ADO_ORG=

# Your project name within the organization (e.g., "MyProject")
ADO_PROJECT=

# The name of your wiki (e.g., "MyProject.wiki" or "MyWiki")
ADO_WIKI=

# Personal Access Token with Wiki read permissions
# Generate from: https://dev.azure.com/{org}/_usersSettings/tokens
ADO_PAT=

# Azure OpenAI Configuration
# Your Azure OpenAI endpoint URL (e.g., "https://myopenai.openai.azure.com/")
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API key
AZURE_OPENAI_KEY=

# Model deployments
# The name of your embedding model deployment
AZURE_OPENAI_EMBED_MODEL=text-embedding-3-large

# The name of your chat completion model deployment
AZURE_OPENAI_CHAT_MODEL=gpt-4.1

# Storage Configuration
# Path where ChromaDB will store its files
CHROMA_DB_PATH=chromadb_storage

# Azure AI Search
SEARCH_SERVICE_NAME=
SEARCH_SERVICE_KEY=
INDEX_NAME=ado_wiki

# Index mode: "text" or "multimodal"
# text       = uses ado_wiki index (text-only, fast ingestion via indexer.py)
# multimodal = uses ado_wiki_images index (text + GPT-4.1 image/mermaid descriptions via indexer_multimodal.py)
INDEX_MODE=text
